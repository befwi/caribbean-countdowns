---
import LiveBanner from "../../components/LiveBanner.astro";
import PageFooter from "../../components/PageFooter.astro";
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="referrer" content="no-referrer" />
  <title>Blog — countdowns.co</title>
  <meta name="description" content="Editorial guides to Caribbean festivals, carnivals and regattas — seasonal picks, dates and tickets, from the countdowns.co event dataset." />
  <style>.t-fr,.t-kr,.t-es{display:none}.lang-row{display:flex;align-items:center;gap:16px}</style>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #0a0f0f;
      color: #e0e0e0;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 14px;
      line-height: 1.6;
      min-height: 100vh;
    }

    a { color: inherit; text-decoration: none; }

    .page { max-width: 860px; margin: 0 auto; padding: 48px 24px 80px; }

    .header-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
    .site-title { font-size: 22px; font-weight: 700; letter-spacing: -0.3px; color: #fff; }

    .back-link { font-size: 13px; color: #888; }
    .back-link:hover { color: #ccc; }

    .lang-group { display: flex; gap: 4px; flex-shrink: 0; }
    .lang-btn {
      background: transparent; border: 1px solid #555; border-radius: 3px;
      cursor: pointer; font-size: 18px; padding: 2px 6px; color: #aaa;
      font-family: inherit; transition: all 0.15s; opacity: 0.5;
    }
    .lang-btn:hover { border-color: #888; opacity: 0.8; }
    .lang-btn.active { background: #1a1a1a; border-color: #555; opacity: 1; }

    .divider { border: none; border-top: 1px solid #1a3030; margin: 24px 0 32px; }

    h2 { font-size: 24px; font-weight: 700; color: #fff; margin-bottom: 8px; letter-spacing: -0.3px; }
    .blog-sub { font-size: 14px; color: #888; margin-bottom: 28px; }

    .featured {
      display: block; background: #0d1a1a; border: 1px solid #1a3030;
      border-left: 4px solid #a3e635; border-radius: 8px; padding: 26px 28px;
      margin-bottom: 28px; position: relative; overflow: hidden;
      transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
    }
    .featured::before {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(120% 90% at 0% 0%, #a3e635 0%, transparent 60%);
      opacity: 0.10;
    }
    .featured:hover { transform: translateY(-2px); border-color: #365314; border-left-color: #a3e635; box-shadow: 0 8px 24px #00000066; }
    .featured-label { font-size: 10px; font-weight: 800; color: #a3e635; letter-spacing: 1.2px; margin-bottom: 10px; }
    .featured-icon { position: absolute; right: 24px; top: 22px; font-size: 34px; }
    .featured-title { font-size: 19px; font-weight: 800; color: #fff; line-height: 1.35; margin-bottom: 8px; padding-right: 56px; }
    .featured-desc { font-size: 13px; color: #888; line-height: 1.55; margin-bottom: 14px; max-width: 620px; }
    .featured-meta { display: flex; gap: 18px; font-size: 11px; color: #555; }
    .featured-meta .go { color: #0d9488; font-weight: 700; }
    .featured:hover .go { color: #5eead4; }

    .chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }
    .chip {
      background: transparent; border: 1px solid #1a3030; border-radius: 20px;
      color: #888; font-size: 12px; font-weight: 600; padding: 6px 16px;
      cursor: pointer; font-family: inherit; transition: all 0.15s; letter-spacing: 0.3px;
    }
    .chip:hover { border-color: #0d9488; color: #aaa; }
    .chip.active { background: #0d2a2a; border-color: #0d9488; color: #5eead4; }

    .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; }
    .tile {
      background: #0d1a1a; border: 1px solid #1a3030; border-radius: 8px;
      border-left: 4px solid var(--accent, #0d9488);
      padding: 22px 20px; display: flex; flex-direction: column; gap: 12px;
      position: relative; overflow: hidden;
      transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
    }
    .tile:hover { transform: translateY(-3px); border-color: var(--accent, #0d9488); box-shadow: 0 8px 24px #00000066; }
    .tile.hidden { display: none; }
    .tile-title .ico { margin-right: 8px; }
    .tag { font-size: 10px; font-weight: 800; padding: 3px 10px; border-radius: 5px; letter-spacing: 0.8px; align-self: flex-start; }
    .tag-organizers { color: #a3e635; background: #1a2a08; border: 1px solid #365314; }
    .tag-attendees  { color: #5eead4; background: #0d2a2a; border: 1px solid #0d9488; }
    .tag-guide      { color: #4ade80; background: #0d2a0d; border: 1px solid #166534; }
    .tag-data       { color: #fbbf24; background: #1a1000; border: 1px solid #d97706; }
    .tile-title { font-size: 14px; font-weight: 700; color: #fff; line-height: 1.45; flex-grow: 1; }
    .tile-meta { display: flex; justify-content: space-between; gap: 8px; font-size: 11px; color: #555; }
    .tile-meta .go { color: #0d9488; white-space: nowrap; }
    .tile:hover .go { color: #5eead4; }
  </style>
</head>

<body>
<LiveBanner />
  <div class="page">

    <div class="header-row">
